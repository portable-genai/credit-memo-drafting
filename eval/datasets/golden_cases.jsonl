# Golden credit-memo cases for the offline eval gate. Every case is fictional EXCEPT
# case-flowserve-real, which carries a real registrant's filed figures (see the note below).
# Fields: id, borrower_name, sector, jurisdiction, documents[], evidence[],
# expected_metrics{}, expected_covenants[], expected_risk_categories[], pii_in_inputs.
# pii_in_inputs=true makes run_eval.py inject that jurisdiction's national identifier
# (_PII_BY_JURISDICTION) into the borrower name, so pii_safety proves the redactor masks
# the pack this borrower is actually governed by. One case per market carries PII (SG/HK/
# AU/JP); case-nimbus-tech stays clean as the control that an ordinary memo is untouched.
# spread{} is the confirmed financial spread the analyst typed: the ratio engine
# computes from it, and a covenant whose type the policy table maps is tested against
# the COMPUTED value rather than the one the model read off a page. expected_ratios{}
# is what the catalogue must reproduce exactly (ratio_reproducibility == 1.0).
# expected_spread{} pins the OPERANDS (a reproducible ratio over the wrong EBITDA is still
# the wrong ratio). expected_tie_out[] names the reconciliations a case is built to trip;
# an empty list means the file is clean and is scored just as strictly, because a tie-out
# that cries wolf on a clean file gets switched off.
# case-flowserve-real is NOT fictional: it is Flowserve Corporation's filed FY2025
# figures (SEC CIK 30625, accession 0000030625-26-000003), so the gate is measured
# against numbers a reader can check. The thresholds it is tested against are still
# this repo's invented example limits. Every other case below is fully fictional.
{"id": "case-flowserve-real", "borrower_name": "Flowserve Corporation", "sector": "manufacturing", "jurisdiction": "US", "documents": ["financial_statement", "loan_agreement", "covenant_certificate"], "evidence": ["The audited FY2025 statements report revenue of USD 4729.3m, EBITDA of USD 495.4m and total debt of USD 1575.1m.", "The bank proposes a maximum net leverage covenant of 3.00x and a minimum debt-service coverage ratio (DSCR) of 1.25x for the new facility.", "The borrower reports current net leverage of 1.64x, after deducting cash of USD 760.2m, and states it was in compliance with all covenants as of 31 December 2025."], "spread": {"currency": "USD", "items": [{"code": "revenue", "period": "FY2025", "value": 4729.3, "currency": "USD"}, {"code": "ebitda", "period": "FY2025", "value": 495.4, "currency": "USD"}, {"code": "total_debt", "period": "FY2025", "value": 1575.1, "currency": "USD"}, {"code": "interest_expense", "period": "FY2025", "value": 77.7, "currency": "USD"}, {"code": "tax_expense", "period": "FY2025", "value": 155.6, "currency": "USD"}, {"code": "capex", "period": "FY2025", "value": 70.9, "currency": "USD"}, {"code": "scheduled_debt_service", "period": "FY2025", "value": 49.6, "currency": "USD"}, {"code": "current_assets", "period": "FY2025", "value": 3042.9, "currency": "USD"}, {"code": "current_liabilities", "period": "FY2025", "value": 1501.9, "currency": "USD"}, {"code": "total_equity", "period": "FY2025", "value": 2191.4, "currency": "USD"}, {"code": "intangible_assets", "period": "FY2025", "value": 198.5, "currency": "USD"}, {"code": "inventory", "period": "FY2025", "value": 789.9, "currency": "USD"}], "periods": [{"label": "FY2025", "ends_on": "2025-12-31", "months": 12, "audited": true}]}, "expected_spread": {"ebitda": {"FY2025": 495.4}, "total_debt": {"FY2025": 1575.1}}, "expected_metrics": {"revenue": 4729.3, "ebitda": 495.4}, "expected_ratios": {"leverage.v1": {"FY2025": 3.1794509487283005}, "dscr.v1": {"FY2025": 5.421370967741935}}, "expected_covenants": [{"type": "leverage", "threshold": 3.0, "operator": "<=", "current_value": 1.64, "status": "breach"}, {"type": "dscr", "threshold": 1.25, "operator": ">=", "current_value": 5.421370967741935, "status": "compliant"}], "expected_tie_out": ["certificate_agrees"], "expected_risk_categories": [], "pii_in_inputs": false}
