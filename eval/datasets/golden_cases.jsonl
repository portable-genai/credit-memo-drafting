# Synthetic golden credit-memo cases for the offline eval gate. ALL data is fictional.
# Fields: id, borrower_name, sector, jurisdiction, documents[], evidence[],
# expected_metrics{}, expected_covenants[], expected_risk_categories[], pii_in_inputs.
# pii_in_inputs=true makes run_eval.py inject that jurisdiction's national identifier
# (_PII_BY_JURISDICTION) into the borrower name, so pii_safety proves the redactor masks
# the pack this borrower is actually governed by. One case per market carries PII (SG/HK/
# AU/JP); case-nimbus-tech stays clean as the control that an ordinary memo is untouched.
{"id": "case-acme-mfg", "borrower_name": "Acme Manufacturing (FICTIONAL)", "sector": "manufacturing", "jurisdiction": "SG", "documents": ["financial_statement", "loan_agreement", "covenant_certificate"], "evidence": ["The audited statements report revenue of USD 120m and EBITDA of USD 24m with net leverage of 2.5x.", "The facility sets a maximum net-leverage covenant of 3.0x and a minimum DSCR of 1.25x.", "The covenant certificate reports current leverage 2.5x and current DSCR 1.40x."], "expected_metrics": {"revenue": 120.0, "ebitda": 24.0, "leverage": 2.5}, "expected_covenants": [{"type": "leverage", "threshold": 3.0, "operator": "<=", "current_value": 2.5, "status": "compliant"}, {"type": "dscr", "threshold": 1.25, "operator": ">=", "current_value": 1.4, "status": "compliant"}], "expected_risk_categories": ["concentration"], "pii_in_inputs": true}
{"id": "case-orion-logistics", "borrower_name": "Orion Logistics (FICTIONAL)", "sector": "logistics", "jurisdiction": "HK", "documents": ["financial_statement", "loan_agreement"], "evidence": ["The statements report revenue of USD 80m and EBITDA of USD 12m with net leverage of 3.4x.", "The facility sets a maximum net-leverage covenant of 3.0x, tested quarterly."], "expected_metrics": {"revenue": 80.0, "ebitda": 12.0, "leverage": 3.4}, "expected_covenants": [{"type": "leverage", "threshold": 3.0, "operator": "<=", "current_value": 3.4, "status": "breach"}], "expected_risk_categories": ["leverage"], "pii_in_inputs": true}
{"id": "case-vega-retail", "borrower_name": "Vega Retail Group (FICTIONAL)", "sector": "retail", "jurisdiction": "AU", "documents": ["financial_statement", "covenant_certificate"], "evidence": ["The statements report EBITDA of USD 30m with an interest cover of 4.0x.", "The covenant certificate reports a current ratio of 1.05x against a 1.10x minimum."], "expected_metrics": {"ebitda": 30.0, "interest_cover": 4.0}, "expected_covenants": [{"type": "current_ratio", "threshold": 1.1, "operator": ">=", "current_value": 1.05, "status": "breach"}], "expected_risk_categories": ["liquidity"], "pii_in_inputs": true}
{"id": "case-nimbus-tech", "borrower_name": "Nimbus Technologies (FICTIONAL)", "sector": "technology", "jurisdiction": "SG", "documents": ["financial_statement", "loan_agreement"], "evidence": ["The statements report revenue of USD 50m and EBITDA of USD 5m with net leverage of 2.9x.", "The facility sets a maximum net-leverage covenant of 3.0x."], "expected_metrics": {"revenue": 50.0, "ebitda": 5.0, "leverage": 2.9}, "expected_covenants": [{"type": "leverage", "threshold": 3.0, "operator": "<=", "current_value": 2.9, "status": "at_risk"}], "expected_risk_categories": ["profitability"], "pii_in_inputs": false}
{"id": "case-delta-energy", "borrower_name": "Delta Energy Partners (FICTIONAL)", "sector": "energy", "jurisdiction": "JP", "documents": ["financial_statement", "loan_agreement", "covenant_certificate"], "evidence": ["The statements report EBITDA of USD 40m with a DSCR of 1.60x.", "The facility sets a minimum DSCR covenant of 1.20x.", "The covenant certificate reports current DSCR 1.60x."], "expected_metrics": {"ebitda": 40.0, "dscr": 1.6}, "expected_covenants": [{"type": "dscr", "threshold": 1.2, "operator": ">=", "current_value": 1.6, "status": "compliant"}], "expected_risk_categories": ["sector"], "pii_in_inputs": true}
