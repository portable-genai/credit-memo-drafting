# Credit-Memo / Underwriting Assistant (B2) — example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# Every var below is consumed by config/settings.yaml via ${VAR:-default} interpolation.
# The local/test profile needs NONE of the GCP-specific values — only CREDIT_MEMO_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.  'local' is a WORKING offline stack (SQLite FTS5 +
# a deterministic LLM): no GCP SDK, no API key, no emulator. The dev / test default.
CREDIT_MEMO_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Region is PINNED to asia-southeast1 in config/settings.yaml — not an env var.
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
# CREDIT_MEMO_KMS_KEY=projects/your-project/locations/asia-southeast1/keyRings/credit-memo/cryptoKeys/credit-memo

# Toggle public-web grounding (off by default for B2). true | false.
CREDIT_MEMO_GROUNDING_ENABLED=false

# ---------------------------------------------------------------------------
# Identity & embedding surface (read directly by api/app.py + adapters/gcp/iap_identity.py,
# not via settings.yaml). See docs/embedding-and-identity.md.
# ---------------------------------------------------------------------------
# IAP audience (gcp/platform profiles): the exact structured protected-resource path the
# backend verifies the x-goog-iap-jwt-assertion against. Required in secure mode.
# CREDIT_MEMO_IAP_AUDIENCE=/projects/000000000000/global/backendServices/0000000000000000000
# Explicit CORS origin allowlist for the cross-origin / standalone case (comma-separated).
# Never "*". Three states, so both variables below are left COMMENTED OUT rather than
# assigned an empty value: an empty assignment is a state of its own, not "not configured".
#   unset (commented out) => localhost dev origins, under a deliberately chosen local
#                            profile only; nothing at all otherwise
#   set and empty         => DENIES every cross-origin request
#   set and valid         => exactly those origins
# Same-origin embedding needs no CORS.
#CREDIT_MEMO_CORS_ORIGINS=
# CSP frame-ancestors allowlist: parent origins permitted to iframe the UI (space-separated).
#   unset (commented out) => 'self' (nothing but same-origin may frame it)
#   set and empty         => 'none' (nobody may frame it, X-Frame-Options: DENY)
#   set and valid         => exactly those parent origins
#CREDIT_MEMO_FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Document extraction — Document AI (gcp profile)
# ---------------------------------------------------------------------------
# Processor id: projects/.../locations/asia-southeast1/processors/...
# CREDIT_MEMO_DOCAI_PROCESSOR=projects/your-project/locations/asia-southeast1/processors/replace-me

# ---------------------------------------------------------------------------
# PII redaction — Sensitive Data Protection / DLP (gcp profile)
# ---------------------------------------------------------------------------
# CREDIT_MEMO_DLP_INSPECT_TEMPLATE=projects/your-project/locations/asia-southeast1/inspectTemplates/replace-me
# CREDIT_MEMO_DLP_DEIDENTIFY_TEMPLATE=projects/your-project/locations/asia-southeast1/deidentifyTemplates/replace-me

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
# CREDIT_MEMO_AGENT_ENGINE=projects/your-project/locations/asia-southeast1/reasoningEngines/replace-me

# ---------------------------------------------------------------------------
# Local profile (offline) — SQLite store paths. Unset => defaults under ~/.credit_memo/.
# Set to ':memory:' for an ephemeral, deterministic run (e.g. CI smoke).
# ---------------------------------------------------------------------------
# CREDIT_MEMO_LOCAL_DB=:memory:
# CREDIT_MEMO_LOCAL_AUDIT=:memory:

# Optional higher-fidelity local: point the in-process stores at Google's official
# emulators. Unset by default (the local profile is fully SDK-free + emulator-free).
# Requires the [gcp] extra installed; the google client is imported lazily, only here.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Platform-profile sibling service URLs (consumed by the platform adapters).
# Defaults point at localhost; override per deployment.
# ---------------------------------------------------------------------------
GUARDRAIL_GATEWAY_URL=http://localhost:8080      # A1 guardrail + redaction
KNOWLEDGE_BASE_URL=http://localhost:8082             # A2 enterprise knowledge base (B2's RAG store)
AGENT_REGISTRY_URL=http://localhost:8083       # A3 agent registry
QUALITY_GATE_URL=http://localhost:8084        # A4 AI quality / eval gate
OBSERVABILITY_URL=http://localhost:8085  # A5 observability / audit

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# CREDIT_MEMO_SETTINGS=config/settings.yaml

# Maker-checker console (rule R8). Required by the gcp and platform profiles: an
# escalation with nowhere to go is a memo that says a human will review it and no human
# who was told. Unset outside those profiles, where the audit ESCALATED record is the
# escalation of record.
HUMAN_REVIEW_URL=
